    <!-- ==================== MAIN ==================== -->

    <main>


        <!-- ==================== HERO / BERANDA ==================== -->

        <section class="hero" id="home">

            <div class="container hero-grid">

                <div class="reveal">

                    <div class="badge">
                        <i class="fa-solid fa-sparkles"></i>
                        Belajar Bahasa, Raih Masa Depan
                    </div>

                    <h1>
                        AKU <span>BISA</span>
                    </h1>

                    <h2>
                        Aplikasi Kreatif Untuk Bisa Semua Bahasa
                    </h2>

                    <p>
                        Tingkatkan kemampuan bahasa Anda dengan cara yang menyenangkan,
                        interaktif, dan mudah diakses kapan saja dan di mana saja.
                    </p>

                    <div class="hero-buttons">

                        <a class="btn btn-primary" href="register.html">
                            Mulai Sekarang
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                        <button class="btn btn-outline"
                            onclick="showMessage('Video pengenalan AKU BISA akan segera tersedia.')">
                            <i class="fa-solid fa-play"></i>
                            Tonton Video
                        </button>

  <div class="learners">
          <div class="avatars">
            <span>👩🏻</span><span>👨🏻</span><span>👩🏼</span><span>👨🏽</span><span>👩🏾</span>
          </div>
          <p><strong>10.000+</strong><br>pelajar dari seluruh Indonesia</p>
        </div>
      </div>

                    </div>

                    <div class="quick-info">

                        <div>
                            <i class="fa-solid fa-globe"></i>
                            <strong>10+ Bahasa</strong>
                            <small>Bahasa populer dunia</small>
                        </div>

                        <div>
                            <i class="fa-solid fa-book-open"></i>
                            <strong>Materi Lengkap</strong>
                            <small>Dari dasar hingga mahir</small>
                        </div>

                        <div>
                            <i class="fa-solid fa-mobile-screen"></i>
                            <strong>Akses Fleksibel</strong>
                            <small>HP, tablet, komputer</small>
                        </div>

                        <div>
                            <i class="fa-solid fa-star"></i>
                            <strong>Metode Interaktif</strong>
                            <small>Belajar lebih menyenangkan</small>
                        </div>

                    </div>

                </div>


                <div class="hero-visual reveal">

                    <span class="language-tag t1">🇬🇧 English</span>
