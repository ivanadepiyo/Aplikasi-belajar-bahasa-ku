                    <span class="language-tag t3">🇯🇵 日本語</span>
                    <span class="language-tag t4">🇩🇪 Deutsch</span>
                    <span class="language-tag t5">🇸🇦 العربية</span>

                    <img src="https://images.unsplash.com/photo-1522202176988-66273c2fd55f?auto=format&fit=crop&w=900&q=85"
                        alt="Pelajar AKU BISA">

                </div>

            </div>

        </section>


        <!-- ==================== FITUR ==================== -->

        <section class="section" id="fitur">

            <div class="container">

                <div class="feature-layout">

                    <div class="feature-intro reveal">

                        <div class="kicker">
                            Fitur Unggulan
                        </div>

                        <h2>
                            Kenapa Memilih
                            <span style="color:var(--blue)">AKU BISA?</span>
                        </h2>

                        <p>
                            Kami menghadirkan pengalaman belajar bahasa yang modern,
                            interaktif, dan disesuaikan dengan kebutuhan Anda.
                        </p>

                        <a class="btn btn-primary" href="#bahasa">
                            Lihat Semua Fitur
                            <i class="fa-solid fa-arrow-right"></i>
                        </a>

                    </div>


                    <div class="cards reveal">

                        <div class="card">
                            <div class="icon">
                                <i class="fa-solid fa-language"></i>
                            </div>
                            <h3>Kursus Bahasa Lengkap</h3>
                            <p>Materi terstruktur dari pemula hingga tingkat mahir.</p>
                        </div>

                        <div class="card">
                            <div class="icon">
                                <i class="fa-solid fa-brain"></i>
                            </div>
                            <h3>Latihan Interaktif</h3>
                            <p>Soal, kuis, dan simulasi percakapan nyata.</p>
                        </div>

                        <div class="card">
                            <div class="icon">
                                <i class="fa-solid fa-mobile-screen-button"></i>
                            </div>
                            <h3>Akses Fleksibel</h3>
                            <p>Belajar kapan saja melalui berbagai perangkat.</p>
                        </div>

                        <div class="card">
                            <div class="icon">
                                <i class="fa-solid fa-user-tie"></i>
                            </div>
                            <h3>Tutor Profesional</h3>
                            <p>Dibimbing oleh pengajar berpengalaman.</p>
                        </div>

                        <div class="card">
                            <div class="icon">
                                <i class="fa-solid fa-chart-line"></i>
                            </div>
                            <h3>Progress Tracking</h3>
                            <p>Pantau perkembangan belajar Anda.</p>
                        </div>

                        <div class="card">
                            <div class="icon">
                                <i class="fa-solid fa-certificate"></i>
                            </div>
                            <h3>Sertifikat</h3>
                            <p>Dapatkan sertifikat setelah menyelesaikan kursus.</p>
                        </div>

                    </div>

                </div>

            </div>

        </section>


        <!-- ==================== BAHASA ==================== -->

        <section class="section alt" id="bahasa">

            <div class="container">

                <div class="section-head reveal">

                    <div class="kicker">
                        Pilih Bahasa yang Kamu Ingin Pelajari
                    </div>

                    <h2>
                        Bahasa yang Tersedia
                    </h2>

                    <p>
                        Jelajahi berbagai bahasa yang ada di seluruh dunia dan buka lebih banyak peluang
                        untuk karier dan masa depan mu.
                    </p>

                </div>


                <div class="languages reveal">

                    <div class="lang">
                        <div class="flag">🇬🇧</div>
                        <strong>Inggris</strong>
                        <small>English</small>
                    </div>

                    <div class="lang">
                        <div class="flag">🇯🇵</div>
                        <strong>Jepang</strong>
                        <small>日本語</small>
                    </div>

