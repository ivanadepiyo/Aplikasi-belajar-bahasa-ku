                        <small>中文</small>
                    </div>

                    <div class="lang">
                        <div class="flag">🇷🇺</div>
                        <strong>Rusia</strong>
                        <small>Русский</small>
                    </div>

                    <div class="lang">
                        <div class="flag">🇮🇹</div>
                        <strong>Italia</strong>
                        <small>Italiano</small>
                    </div>

                </div>

