        <!-- ==================== FAQ ==================== -->

        <section class="section alt" id="faq">

            <div class="container">

                <div class="section-head reveal">

                    <div class="kicker">
                        Pertanyaan Umum
                    </div>

                    <h2>
                        Pertanyaan yang Sering Diajukan
                    </h2>

                </div>


                <div class="faq reveal">

                    <div class="faq-item">

                        <button class="faq-question">
                            Apakah AKU BISA gratis?
                            <i class="fa-solid fa-plus"></i>
                        </button>

                        <div class="faq-answer">
                            AKU BISA menyediakan materi gratis dan pilihan kelas premium
                            untuk pembelajaran lebih mendalam.
                        </div>

                    </div>


                    <div class="faq-item">

                        <button class="faq-question">
                            Bahasa apa saja yang tersedia?
                            <i class="fa-solid fa-plus"></i>
                        </button>

                        <div class="faq-answer">
                            Tersedia lebih dari 10 bahasa, termasuk Inggris, Jepang,
                            Korea, Arab, Spanyol, dan Jerman.
                        </div>

                    </div>


                    <div class="faq-item">

                        <button class="faq-question">
                            Apakah bisa belajar melalui HP?
                            <i class="fa-solid fa-plus"></i>
                        </button>

                        <div class="faq-answer">
                            Bisa. Website dirancang responsif dan dapat diakses
                            melalui HP, tablet, maupun komputer.
                        </div>

                    </div>


                    <div class="faq-item">

                        <button class="faq-question">
                            Apakah mendapatkan sertifikat?
                            <i class="fa-solid fa-plus"></i>
                        </button>

                        <div class="faq-answer">
                            Pengguna dapat memperoleh sertifikat setelah menyelesaikan
                            kelas yang memenuhi persyaratan.
                        </div>

                    </div>

                </div>

            </div>

