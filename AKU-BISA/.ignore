        </section>


        <!-- ==================== CARA BELAJAR ==================== -->

        <section class="section" id="cara">

            <div class="container">

                <div class="section-head reveal">

                    <div class="kicker">
                        Mudah, Praktis, Menyenangkan
                    </div>

                    <h2>
                        Cara Belajar di AKU BISA
                    </h2>

                    <p>
                        Hanya dalam beberapa langkah, Anda sudah bisa mulai
                        menguasai bahasa impian.
                    </p>

                </div>


                <div class="steps reveal">

                    <div class="step">
                        <div class="step-number">1</div>
                        <h3>Daftar Akun</h3>
                        <p>Buat akun gratis dengan mudah.</p>
                    </div>

                    <div class="step">
                        <div class="step-number">2</div>
                        <h3>Pilih Bahasa</h3>
                        <p>Tentukan bahasa yang ingin dipelajari.</p>
                    </div>

                    <div class="step">
                        <div class="step-number">3</div>
                        <h3>Mulai Belajar</h3>
                        <p>Akses materi, latihan, dan kuis interaktif.</p>
                    </div>

                    <div class="step">
                        <div class="step-number">4</div>
                        <h3>Raih Kemajuan</h3>
                        <p>Dapatkan sertifikat dan tingkatkan kemampuan.</p>
                    </div>

                </div>

            </div>

        </section>


